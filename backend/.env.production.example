# ============================================================
# GarageClick — PRODUCTION environment variables (template)
# Set these in your hosting platform (Render/Railway) — never commit real values.
# ============================================================

# ----- MySQL (use a MANAGED database, not localhost) -----
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_USER=garageclick
DB_PASSWORD=__set_a_strong_password__
DB_NAME=garageclick
# Tests only — not used in production:
# DB_NAME_TEST=garageclick_test

# ----- Auth -----
# Generate a strong 32+ byte secret, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=__paste_a_strong_random_secret__
JWT_EXPIRES_HOURS=8

# ----- CORS -----
# Comma-separated list of the EXACT frontend origin(s). Do NOT use "*" in prod.
CORS_ORIGINS=https://your-frontend-domain.com

# ----- Notifications (WhatsApp) -----
# "mock" = no external calls. "twilio" = real sends (requires the creds below).
NOTIFICATIONS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=__your_account_sid__
TWILIO_AUTH_TOKEN=__your_auth_token__
TWILIO_WHATSAPP_FROM=+14155238886

# ----- Server -----
# Most platforms inject PORT automatically; the start command reads it.
PORT=8000
