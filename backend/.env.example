# ----- Server -----
PORT=3000
NODE_ENV=development

# ----- MySQL Database -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=garageclick
DB_CONNECTION_LIMIT=10

# Separate database used by the Jest integration tests (npm test).
# WARNING: its tables are TRUNCATED between tests — never point this at prod data.
DB_NAME_TEST=garageclick_test

# ----- Auth -----
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=8h
