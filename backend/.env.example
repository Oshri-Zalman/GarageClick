# ----- MySQL Database -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=garageclick

# Separate database used by the pytest suite (pytest).
# WARNING: its tables are wiped between tests — never point this at prod data.
DB_NAME_TEST=garageclick_test

# ----- Auth -----
JWT_SECRET=change_this_in_production
JWT_EXPIRES_HOURS=8

# ----- Notifications (WhatsApp) -----
# "mock" = log only (default, no external calls). "twilio" = send real messages.
NOTIFICATIONS_PROVIDER=mock
# Required only when NOTIFICATIONS_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
